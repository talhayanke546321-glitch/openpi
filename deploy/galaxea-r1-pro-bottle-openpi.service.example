[Unit]
Description=Galaxea R1 Pro bottle-place OpenPI pi0.5 policy server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vipuser
WorkingDirectory=/home/vipuser/robotics/openpi
EnvironmentFile=/etc/openpi/galaxea-r1.env
Environment=OPENPI_DATA_HOME=/home/vipuser/robotics/openpi-data
Environment=XLA_PYTHON_CLIENT_PREALLOCATE=false
Environment=XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
ExecStart=/home/vipuser/.local/bin/uv run scripts/serve_galaxea_r1_pro_bottle.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
KillSignal=SIGINT

# The ROS2 client runs on this same inference workstation, so the policy server
# stays loopback-only. Authentication remains mandatory through OPENPI_API_KEY.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=-/home/vipuser/.cache
ReadWritePaths=-/home/vipuser/robotics/openpi-data
ReadWritePaths=-/home/vipuser/robotics/openpi/policy_records

[Install]
WantedBy=multi-user.target
